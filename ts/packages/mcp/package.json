{
  "name": "@mekik/mcp",
  "version": "0.9.0",
  "description": "MCP transport for mekik — expose a MekikApp's graph as Model Context Protocol tools over Streamable HTTP.",
  "type": "module",
  "license": "MIT",
  "author": "AimTune",
  "homepage": "https://github.com/AimTune/mekik/tree/main/ts/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/mekik.git",
    "directory": "ts/packages/mcp"
  },
  "bugs": "https://github.com/AimTune/mekik/issues",
  "keywords": [
    "mekik",
    "mcp",
    "model-context-protocol",
    "agent",
    "transport"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" test/*.test.ts"
  },
  "dependencies": {
    "@mekik/core": "workspace:*"
  },
  "devDependencies": {
    "@ilmek/core": "^0.1.1"
  }
}
