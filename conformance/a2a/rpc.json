{
  "description": "Agent Card and JSON-RPC exchanges a MekikA2aServer must answer identically in both languages (PROTOCOL.md §14). The agent is configured with the `options` below; message/send results carry minted ids and timestamps and are asserted behaviourally in each suite.",
  "options": {
    "name": "Support desk",
    "description": "Answers questions about orders.",
    "url": "https://bot.example.com/a2a",
    "version": "1.2.0",
    "skills": [
      { "name": "brand-voice", "description": "House style." },
      { "name": "pdf", "description": "Fill PDF forms.", "tags": ["docs"] }
    ]
  },
  "agentCard": {
    "protocolVersion": "0.3.0",
    "name": "Support desk",
    "description": "Answers questions about orders.",
    "url": "https://bot.example.com/a2a",
    "preferredTransport": "JSONRPC",
    "version": "1.2.0",
    "capabilities": { "streaming": false, "pushNotifications": false, "stateTransitionHistory": false },
    "defaultInputModes": ["text/plain"],
    "defaultOutputModes": ["text/plain"],
    "skills": [
      { "id": "chat", "name": "Support desk", "description": "Answers questions about orders.", "tags": ["chat"] },
      { "id": "brand-voice", "name": "brand-voice", "description": "House style.", "tags": [] },
      { "id": "pdf", "name": "pdf", "description": "Fill PDF forms.", "tags": ["docs"] }
    ]
  },
  "cases": [
    {
      "name": "notifications get no response",
      "request": { "jsonrpc": "2.0", "method": "notifications/whatever" },
      "response": null
    },
    {
      "name": "tasks/get of an unknown task is TaskNotFound",
      "request": { "jsonrpc": "2.0", "id": 1, "method": "tasks/get", "params": { "id": "task-nope" } },
      "response": { "jsonrpc": "2.0", "id": 1, "error": { "code": -32001, "message": "task \"task-nope\" not found" } }
    },
    {
      "name": "tasks/cancel of an unknown task is TaskNotFound",
      "request": { "jsonrpc": "2.0", "id": 2, "method": "tasks/cancel", "params": { "id": "task-nope" } },
      "response": { "jsonrpc": "2.0", "id": 2, "error": { "code": -32001, "message": "task \"task-nope\" not found" } }
    },
    {
      "name": "tasks/get without an id is -32602",
      "request": { "jsonrpc": "2.0", "id": 3, "method": "tasks/get", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 3, "error": { "code": -32602, "message": "`id` (string) is required" } }
    },
    {
      "name": "message/stream is UnsupportedOperation",
      "request": { "jsonrpc": "2.0", "id": 4, "method": "message/stream", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 4, "error": { "code": -32004, "message": "message/stream is not supported: this agent does not stream" } }
    },
    {
      "name": "push notification config is UnsupportedOperation",
      "request": { "jsonrpc": "2.0", "id": 5, "method": "tasks/pushNotificationConfig/set", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 5, "error": { "code": -32004, "message": "tasks/pushNotificationConfig/set is not supported: this agent does not push notifications" } }
    },
    {
      "name": "an unknown method is -32601",
      "request": { "jsonrpc": "2.0", "id": 6, "method": "agent/authenticatedExtendedCard" },
      "response": { "jsonrpc": "2.0", "id": 6, "error": { "code": -32601, "message": "method not found: agent/authenticatedExtendedCard" } }
    },
    {
      "name": "message/send without a message is -32602",
      "request": { "jsonrpc": "2.0", "id": 7, "method": "message/send", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 7, "error": { "code": -32602, "message": "`message` is required" } }
    },
    {
      "name": "message/send with an empty parts list is -32602",
      "request": { "jsonrpc": "2.0", "id": 8, "method": "message/send", "params": { "message": { "role": "user", "parts": [] } } },
      "response": { "jsonrpc": "2.0", "id": 8, "error": { "code": -32602, "message": "`message.parts` must be a non-empty array" } }
    },
    {
      "name": "message/send with only a file part is ContentTypeNotSupported",
      "request": { "jsonrpc": "2.0", "id": 9, "method": "message/send", "params": { "message": { "role": "user", "parts": [{ "kind": "file", "file": { "uri": "https://x/y.pdf" } }] } } },
      "response": { "jsonrpc": "2.0", "id": 9, "error": { "code": -32005, "message": "message needs at least one text part" } }
    },
    {
      "name": "message/send on an unknown task is TaskNotFound",
      "request": { "jsonrpc": "2.0", "id": 10, "method": "message/send", "params": { "message": { "role": "user", "taskId": "task-nope", "parts": [{ "kind": "text", "text": "yes" }] } } },
      "response": { "jsonrpc": "2.0", "id": 10, "error": { "code": -32001, "message": "task \"task-nope\" not found" } }
    },
    {
      "name": "a non-object is -32600",
      "request": 42,
      "response": { "jsonrpc": "2.0", "id": null, "error": { "code": -32600, "message": "request must be a JSON-RPC object" } }
    },
    {
      "name": "a missing jsonrpc field is -32600, echoing the id",
      "request": { "id": 11, "method": "tasks/get" },
      "response": { "jsonrpc": "2.0", "id": 11, "error": { "code": -32600, "message": "request must carry jsonrpc \"2.0\" and a method" } }
    },
    {
      "name": "a non-string method is -32600",
      "request": { "jsonrpc": "2.0", "id": 12, "method": null },
      "response": { "jsonrpc": "2.0", "id": 12, "error": { "code": -32600, "message": "request must carry jsonrpc \"2.0\" and a method" } }
    },
    {
      "name": "tasks/resubscribe is UnsupportedOperation",
      "request": { "jsonrpc": "2.0", "id": 13, "method": "tasks/resubscribe", "params": { "id": "t" } },
      "response": { "jsonrpc": "2.0", "id": 13, "error": { "code": -32004, "message": "tasks/resubscribe is not supported: this agent does not stream" } }
    },
    {
      "name": "every push notification config method is UnsupportedOperation",
      "request": { "jsonrpc": "2.0", "id": 14, "method": "tasks/pushNotificationConfig/list", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 14, "error": { "code": -32004, "message": "tasks/pushNotificationConfig/list is not supported: this agent does not push notifications" } }
    },
    {
      "name": "tasks/cancel without an id is -32602",
      "request": { "jsonrpc": "2.0", "id": 15, "method": "tasks/cancel", "params": {} },
      "response": { "jsonrpc": "2.0", "id": 15, "error": { "code": -32602, "message": "`id` (string) is required" } }
    },
    {
      "name": "tasks/get with an empty id is -32602",
      "request": { "jsonrpc": "2.0", "id": 16, "method": "tasks/get", "params": { "id": "" } },
      "response": { "jsonrpc": "2.0", "id": 16, "error": { "code": -32602, "message": "`id` (string) is required" } }
    },
    {
      "name": "message/send without params is -32602",
      "request": { "jsonrpc": "2.0", "id": 17, "method": "message/send" },
      "response": { "jsonrpc": "2.0", "id": 17, "error": { "code": -32602, "message": "`message` is required" } }
    },
    {
      "name": "a message role other than user or agent is -32602",
      "request": { "jsonrpc": "2.0", "id": 18, "method": "message/send", "params": { "message": { "role": "system", "parts": [{ "kind": "text", "text": "x" }] } } },
      "response": { "jsonrpc": "2.0", "id": 18, "error": { "code": -32602, "message": "`message.role` must be \"user\" or \"agent\"" } }
    },
    {
      "name": "a part that is not an object is -32602",
      "request": { "jsonrpc": "2.0", "id": 19, "method": "message/send", "params": { "message": { "role": "user", "parts": ["hi"] } } },
      "response": { "jsonrpc": "2.0", "id": 19, "error": { "code": -32602, "message": "message.parts[0] must be an object" } }
    },
    {
      "name": "a part of an unknown kind is -32602",
      "request": { "jsonrpc": "2.0", "id": 20, "method": "message/send", "params": { "message": { "role": "user", "parts": [{ "kind": "image", "url": "x" }] } } },
      "response": { "jsonrpc": "2.0", "id": 20, "error": { "code": -32602, "message": "message.parts[0] must be a text, data or file part" } }
    },
    {
      "name": "a text part whose text is not a string is -32602",
      "request": { "jsonrpc": "2.0", "id": 21, "method": "message/send", "params": { "message": { "role": "user", "parts": [{ "kind": "text", "text": 5 }] } } },
      "response": { "jsonrpc": "2.0", "id": 21, "error": { "code": -32602, "message": "message.parts[0] must be a text, data or file part" } }
    },
    {
      "name": "a non-string taskId is -32602",
      "request": { "jsonrpc": "2.0", "id": 22, "method": "message/send", "params": { "message": { "role": "user", "taskId": 5, "parts": [{ "kind": "text", "text": "x" }] } } },
      "response": { "jsonrpc": "2.0", "id": 22, "error": { "code": -32602, "message": "`message.taskId` must be a string" } }
    },
    {
      "name": "a non-string contextId is -32602",
      "request": { "jsonrpc": "2.0", "id": 23, "method": "message/send", "params": { "message": { "role": "user", "contextId": 5, "parts": [{ "kind": "text", "text": "x" }] } } },
      "response": { "jsonrpc": "2.0", "id": 23, "error": { "code": -32602, "message": "`message.contextId` must be a string" } }
    },
    {
      "name": "a data-only message starting a task is ContentTypeNotSupported",
      "request": { "jsonrpc": "2.0", "id": 24, "method": "message/send", "params": { "message": { "role": "user", "parts": [{ "kind": "data", "data": { "q": 1 } }] } } },
      "response": { "jsonrpc": "2.0", "id": 24, "error": { "code": -32005, "message": "message needs at least one text part" } }
    },
    {
      "name": "a whitespace-only text message is ContentTypeNotSupported",
      "request": { "jsonrpc": "2.0", "id": 25, "method": "message/send", "params": { "message": { "role": "user", "parts": [{ "kind": "text", "text": "  \n " }] } } },
      "response": { "jsonrpc": "2.0", "id": 25, "error": { "code": -32005, "message": "message needs at least one text part" } }
    }
  ]
}
